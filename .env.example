# Скопируйте в web_kp/.env на сервере (или в корневой .env)

WEB_KP_DATABASE_URL=sqlite:////app/data/web_kp.db
PUBLIC_BASE_URL=http://kp-maker.ru
SITE_ACCESS_CODE=

# Почта Mail.ru (пароль приложения, не основной пароль ящика)
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=Sales@goldcontainer.ru
SMTP_PASSWORD=
SMTP_FROM=Sales@goldcontainer.ru

IMAP_HOST=imap.mail.ru
IMAP_PORT=993
IMAP_USER=Sales@goldcontainer.ru
IMAP_PASSWORD=

# Yandex GPT (Yandex Cloud → API-ключ + ID каталога b1g...)
# НЕ путать с YANDEX_TOKEN (это Яндекс.Диск для бота каталога)
LLM_PROVIDER=yandex
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite

# Опционально OpenAI вместо Yandex
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
